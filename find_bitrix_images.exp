#!/usr/bin/expect -f
set timeout 300
set pass "nE315uSK*?t#DQ"
spawn ssh -o StrictHostKeyChecking=no root@147.45.155.163 "cd /root/liberty-wear/backend && ./venv/bin/python3 -c \"
import asyncio
from app.services.bitrix import bitrix_service
async def find_images():
    products = await bitrix_service.get_all_products()
    found = False
    for p in products:
        img = p.get('PROPERTY_45') or p.get('PREVIEW_PICTURE') or p.get('DETAIL_PICTURE')
        if img:
            print(f'FOUND PRODUCT WITH IMAGE! ID: {p.get(\\\"ID\\\")}, Name: {p.get(\\\"NAME\\\")}, Image: {img}')
            found = True
            break
    if not found:
        print('No products with images found in the selected fields.')
asyncio.run(find_images())
\""
expect "*password:*"
send -- "$pass\r"
expect eof
