#!/usr/bin/expect -f
set timeout 120
set pass "nE315uSK*?t#DQ"
spawn ssh -o StrictHostKeyChecking=no root@147.45.155.163 "cd /root/liberty-wear/backend && ./venv/bin/python3 -c \"
from app.db.session import SessionLocal
from app.models.user import User
from app.core.security import get_password_hash
db = SessionLocal()
user = db.query(User).filter(User.email == 'admin@liberty.uz').first()
if not user:
    new_user = User(
        email='admin@liberty.uz',
        hashed_password=get_password_hash('admin123'),
        full_name='Admin Liberty',
        is_active=True,
        is_superuser=True,
        role='admin'
    )
    db.add(new_user)
    db.commit()
    print('User admin@liberty.uz created with password: admin123')
else:
    user.hashed_password = get_password_hash('admin123')
    db.commit()
    print('Password for admin@liberty.uz updated to: admin123')
db.close()
\""
expect "*password:*"
send -- "$pass\r"
expect eof
