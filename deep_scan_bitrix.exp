#!/usr/bin/expect -f
set timeout 300
set pass "nE315uSK*?t#DQ"
spawn ssh -o StrictHostKeyChecking=no root@147.45.155.163 "cd /root/liberty-wear/backend && ./venv/bin/python3 -c \"
import asyncio
import json
from app.services.bitrix import bitrix_service
async def deep_scan():
    # Fetch top 10 products with ALL fields
    result = await bitrix_service._call('crm.product.list', {
        'order': {'ID': 'DESC'},
        'select': ['*', 'PROPERTY_*'],
        'limit': 10
    })
    if isinstance(result, list):
        for p in result:
            print(f'PRODUCT ID: {p.get(\\\"ID\\\")}, NAME: {p.get(\\\"NAME\\\")}')
            # Print only fields that have values to reduce noise
            for k, v in p.items():
                if v:
                    print(f'  {k}: {v}')
            print('---')
    else:
        print('Error fetching products or result is empty.')
asyncio.run(deep_scan())
\""
expect "*password:*"
send -- "$pass\r"
expect eof
